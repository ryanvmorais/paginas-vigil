---
/**
 * @file Layout base das páginas: `<html>`, `<head>` bilíngue e corpo.
 *
 * Emite sozinho a marcação que faz uma página bilíngue ser indexada certo (RF-03): `lang`, `title`,
 * `description`, `canonical` da própria versão, o trio `alternate` (`pt-BR`, `en` e `x-default`
 * apontando para `/en/`) e `og:locale` com o `og:locale:alternate`. Nada redireciona por idioma do
 * navegador: a troca é só pelo seletor. Importa os três CSS globais, então o app não os conhece.
 *
 * A marca vem de arquivos da pasta `public/` de cada app: `favicon.svg`, `apple-touch-icon.png` e a
 * imagem de compartilhamento `social-<idioma>.png` (`og:image`, com dimensões e texto alternativo).
 *
 * As URLs absolutas vêm de `Astro.site` (campo `site` do `astro.config.mjs` de cada app). Os dois
 * `preload` cobrem as fontes que aparecem no topo (Sora 800 e JetBrains Mono 400), para a troca de
 * fonte não deslocar o layout (RNF-03). Sem `<script>` nem `style=` aqui (RNF-01).
 *
 * Com `indexavel={false}` (a página 404) a página sai fora dos buscadores e não tem versão
 * "oficial": emite `<meta name="robots" content="noindex">` e omite `canonical`, `alternate`, `og:*` e
 * `twitter:card`, que só fazem sentido numa página que se indexa e se compartilha (spec 006, ADR-7).
 *
 * A medição liga só com um identificador válido em `PUBLIC_GA_MEASUREMENT_ID` (lido em tempo de
 * build): então o banner de consentimento é o primeiro filho do `<body>`, para o teclado e o leitor
 * de tela o encontrarem sem atravessar a página. Sem identificador (ou inválido) nada é renderizado
 * e o build segue (RF-06, ADR-7).
 */
import "../estilos/fontes.css";
import "../estilos/tokens.css";
import "../estilos/base.css";

import { caminhoNoIdioma, outroIdioma } from "../caminhos";
import Consentimento from "../componentes/Consentimento.astro";
import type { Idioma } from "../idiomas";
import { validarIdMedicao } from "../medicao";
import jetbrainsMono400 from "../fontes/jetbrains-mono-400.woff2?url";
import sora800 from "../fontes/sora-800.woff2?url";

export interface Props {
  /** Produto da página: escolhe o acento de cor (`data-produto`). */
  produto: "webvigil" | "mailvigil";
  /** Idioma da página. */
  idioma: Idioma;
  /** Caminho da página na versão atual (`/`, `/en/`, `/x/`); `Astro.url.pathname` serve. */
  caminho: string;
  titulo: string;
  descricao: string;
  /**
   * Texto alternativo da imagem de compartilhamento (`og:image:alt`), no idioma da página;
   * obrigatório se a página é indexável.
   */
  imagemSocialAlt?: string;
  /** Caminho ou URL da imagem de compartilhamento; o padrão é `/social-<idioma>.png`, de `public/`. */
  imagemSocial?: string;
  /** `false` tira a página dos buscadores e do compartilhamento (404); o padrão é `true`. */
  indexavel?: boolean;
}

// A imagem de compartilhamento tem sempre 1280 x 640 (um teste confere os arquivos de cada app).
const LARGURA_IMAGEM = 1280;
const ALTURA_IMAGEM = 640;

const {
  produto,
  idioma,
  caminho,
  titulo,
  descricao,
  imagemSocialAlt,
  indexavel = true,
} = Astro.props;
const imagemSocial = Astro.props.imagemSocial ?? `/social-${idioma}.png`;

if (indexavel && imagemSocialAlt === undefined) {
  throw new Error("Pagina.astro: `imagemSocialAlt` é obrigatório em página indexável.");
}

if (Astro.site === undefined) {
  throw new Error("Pagina.astro: defina `site` no astro.config.mjs para gerar as URLs absolutas.");
}

// Idioma da marcação: `lang` do HTML e `hreflang` usam a tag BCP 47; `og:locale` usa `ll_TT`.
const LANG = { pt: "pt-BR", en: "en" } as const;
const OG_LOCALE = { pt: "pt_BR", en: "en_US" } as const;

const urlNoIdioma = (alvo: Idioma) => new URL(caminhoNoIdioma(caminho, alvo), Astro.site).href;
const canonical = urlNoIdioma(idioma);
const outro = outroIdioma(idioma);
const urlImagem = new URL(imagemSocial, Astro.site).href;
const idMedicao = validarIdMedicao(import.meta.env.PUBLIC_GA_MEASUREMENT_ID);
---

<!doctype html>
<html lang={LANG[idioma]} data-produto={produto}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descricao} />
    <meta name="color-scheme" content="light dark" />
    {indexavel ? (
      <>
        <link rel="canonical" href={canonical} />
        <link rel="alternate" hreflang={LANG.pt} href={urlNoIdioma("pt")} />
        <link rel="alternate" hreflang={LANG.en} href={urlNoIdioma("en")} />
        <link rel="alternate" hreflang="x-default" href={urlNoIdioma("en")} />
        <meta property="og:type" content="website" />
        <meta property="og:title" content={titulo} />
        <meta property="og:description" content={descricao} />
        <meta property="og:url" content={canonical} />
        <meta property="og:locale" content={OG_LOCALE[idioma]} />
        <meta property="og:locale:alternate" content={OG_LOCALE[outro]} />
        <meta property="og:image" content={urlImagem} />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content={String(LARGURA_IMAGEM)} />
        <meta property="og:image:height" content={String(ALTURA_IMAGEM)} />
        <meta property="og:image:alt" content={imagemSocialAlt ?? ""} />
        <meta name="twitter:card" content="summary_large_image" />
      </>
    ) : (
      <meta name="robots" content="noindex" />
    )}
    <link rel="preload" href={sora800} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={jetbrainsMono400} as="font" type="font/woff2" crossorigin />
    {/* O favicon é um arquivo do app (`public/favicon.svg`): declará-lo evita o pedido de /favicon.ico */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    {idMedicao !== undefined && <Consentimento id={idMedicao} idioma={idioma} />}
    <slot />
  </body>
</html>
