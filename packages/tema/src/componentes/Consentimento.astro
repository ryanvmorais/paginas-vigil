---
/**
 * @file Banner de consentimento da medição: cartão fixo no canto da janela, com Recusar e Aceitar.
 *
 * Nasce `hidden` no HTML: o `scripts/consentimento.ts` o revela só quando o visitante ainda não
 * escolheu (ou quando ele reabre pelo "Gerenciar cookies" do rodapé), então quem já escolheu nunca
 * vê o banner piscar e, sem JavaScript, não há banner nem medição a consentir (ADR-4). O
 * `Pagina.astro` o renderiza como primeiro filho do `<body>` e só com identificador de medição
 * válido; o identificador vai no atributo `data-medicao`, e não no JavaScript, para o mesmo arquivo
 * servir com e sem medição (ADR-7).
 *
 * "Recusar" e "Aceitar" usam a mesma classe e a mesma regra de CSS: a única diferença é o rótulo
 * (RF-02). O estilo é o da alternativa A do mockup (contorno nos dois). Texto, título e ícone são os
 * do banner do site principal; o que diz respeito à ferramenta e à mudança de escolha fica na
 * política e no controle do rodapé.
 *
 * Atribuição do ícone: "cookie-bite", do Font Awesome Free 6.7.2 (https://fontawesome.com), licença
 * CC BY 4.0 (https://creativecommons.org/licenses/by/4.0/). O desenho entra como SVG embutido, sem a
 * biblioteca; a atribuição também está no `NOTICE` da raiz do repositório.
 */
import type { Idioma } from "../idiomas";
import { POLITICA } from "../politica";
import { textos } from "../textos";

export interface Props {
  /** Identificador de medição já validado por `validarIdMedicao`. */
  id: string;
  idioma: Idioma;
}

const { id, idioma } = Astro.props;
const t = textos[idioma].consentimento;
const politica = POLITICA[idioma];
---

<section
  class="consentimento"
  role="region"
  aria-labelledby="consentimento-titulo"
  data-consentimento
  data-medicao={id}
  data-aceita={t.escolhaAceita}
  data-recusada={t.escolhaRecusada}
  hidden
>
  <h2 id="consentimento-titulo" tabindex="-1">
    <svg class="icone" viewBox="0 0 512 512" aria-hidden="true">
      <path
        fill="currentColor"
        d="M257.5 27.6c-.8-5.4-4.9-9.8-10.3-10.6c-22.1-3.1-44.6 .9-64.4 11.4l-74 39.5C89.1 78.4 73.2 94.9 63.4 115L26.7 190.6c-9.8 20.1-13 42.9-9.1 64.9l14.5 82.8c3.9 22.1 14.6 42.3 30.7 57.9l60.3 58.4c16.1 15.6 36.6 25.6 58.7 28.7l83 11.7c22.1 3.1 44.6-.9 64.4-11.4l74-39.5c19.7-10.5 35.6-27 45.4-47.2l36.7-75.5c9.8-20.1 13-42.9 9.1-64.9c-.9-5.3-5.3-9.3-10.6-10.1c-51.5-8.2-92.8-47.1-104.5-97.4c-1.8-7.6-8-13.4-15.7-14.6c-54.6-8.7-97.7-52-106.2-106.8zM208 144a32 32 0 1 1 0 64 32 32 0 1 1 0-64zM144 336a32 32 0 1 1 64 0 32 32 0 1 1 -64 0zm224-64a32 32 0 1 1 0 64 32 32 0 1 1 0-64z"
      ></path>
    </svg>
    {t.titulo}
  </h2>
  <p>
    {`${t.texto} ${t.saibaMais} `}
    <a href={politica.href}>
      {t.politica}
      {!politica.traduzida && ` ${t.foraDoIdioma}`}
    </a>
    .
  </p>
  <p class="escolha-atual" data-escolha-atual hidden>
    {t.escolhaAtual} <span data-escolha-valor></span>.
  </p>
  <div class="acoes">
    <button type="button" class="botao-escolha" data-recusar>
      {t.recusar}
    </button>
    <button type="button" class="botao-escolha" data-aceitar>
      {t.aceitar}
    </button>
  </div>
  <button type="button" class="fechar" data-fechar aria-label={t.fechar}>
    <svg viewBox="0 0 16 16" aria-hidden="true">
      <path
        d="M3 3l10 10M13 3L3 13"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
      ></path>
    </svg>
  </button>
</section>

<script>
  import "../scripts/consentimento";
</script>

<style>
  .consentimento {
    position: fixed;
    z-index: 10;
    left: 12px;
    right: 12px;
    bottom: 12px;
    display: grid;
    gap: 10px;
    padding: 16px 16px 14px;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--card);
    color: var(--text);
    box-shadow: var(--sombra-banner);
  }

  /* `display` acima vence o `hidden` do navegador; sem esta regra o banner nunca fecharia. */
  .consentimento[hidden],
  .escolha-atual[hidden] {
    display: none;
  }

  h2 {
    display: flex;
    align-items: center;
    gap: 8px;
    /* Os 44 px da direita são do botão de fechar, para o título não correr por baixo dele. */
    padding-right: 44px;
    font-family: var(--font-title);
    font-weight: 800;
    font-size: var(--fs-corpo);
    line-height: 1.2;
  }

  /* Foco programático ao reabrir (o leitor de tela anuncia o título): o anel só importa a teclado. */
  h2:focus {
    outline: none;
  }

  .icone {
    flex: none;
    width: 16px;
    height: 16px;
    color: var(--link);
  }

  p {
    color: var(--text-2);
    font-size: var(--fs-codigo);
    line-height: 1.5;
  }

  p a {
    font-weight: 600;
    text-underline-offset: 2px;
  }

  .escolha-atual {
    color: var(--text);
    font-weight: 600;
  }

  .fechar {
    position: absolute;
    top: 4px;
    right: 4px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 10px;
    background: transparent;
    color: var(--text-3);
    cursor: pointer;
  }

  .fechar:hover {
    background: var(--code);
    color: var(--text);
  }

  .fechar svg {
    width: 16px;
    height: 16px;
  }

  .acoes {
    display: flex;
    gap: 10px;
    padding-top: 2px;
  }

  /* Uma só regra para os dois botões: é o que garante o mesmo peso entre Recusar e Aceitar (RF-02). */
  .botao-escolha {
    display: inline-flex;
    flex: 1 1 0;
    align-items: center;
    justify-content: center;
    min-width: 0;
    min-height: 44px;
    padding: 0 18px;
    border: 1.5px solid var(--field);
    border-radius: 10px;
    background: transparent;
    color: var(--text);
    font: inherit;
    font-weight: 600;
    line-height: 1;
    text-align: center;
    cursor: pointer;
  }

  .botao-escolha:hover {
    background: var(--code);
  }

  /* Com o banner aberto, a página reserva no fim da rolagem o espaço do cartão: sem isso ele cobriria
   * os links do rodapé, inclusive o "Gerenciar cookies" que o reabre (WCAG 2.4.11). A classe é posta
   * no `<body>` por `abrir()` em `scripts/consentimento.ts` (`CLASSE_RESERVA`) e sai quando o banner
   * fecha (design, "Reserva de rolagem"). */
  :global(body.reserva-consentimento) {
    padding-bottom: 300px;
  }

  @media (min-width: 720px) {
    .consentimento {
      left: auto;
      right: 20px;
      bottom: 20px;
      width: 392px;
    }

    :global(body.reserva-consentimento) {
      padding-bottom: 270px;
    }
  }
</style>
