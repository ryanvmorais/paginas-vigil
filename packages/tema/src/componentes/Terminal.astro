---
/**
 * @file Terminal: o comando digitado e a saída real dele, a prova do produto.
 *
 * É o único ponto de ênfase da página. O texto completo está sempre no HTML (nada depende de
 * JavaScript): o comando num `span.digita` e a saída (o `slot`) num `span.saida`. O `<pre>` rola na
 * horizontal por dentro do bloco, e a página nunca (RF-08). A animação é só CSS (`terminal.css`, ADR-4);
 * como o CSS não conta texto, este componente conta os caracteres do comando e as linhas da saída no
 * build e escolhe as classes `.n-*` e `.l-*`, falhando o build se o valor passar da faixa.
 */
import "../estilos/terminal.css";

export interface Props {
  /** Rótulo acessível do bloco (lido pelo leitor de tela), por exemplo "Exemplo de saída no terminal". */
  rotulo: string;
  /** Texto do cabeçalho do terminal: o que a saída mostra. */
  titulo: string;
  /** Comando digitado, sem o `$` do prompt. */
  comando: string;
}

const { rotulo, titulo, comando } = Astro.props;

// Faixas cobertas por `terminal.css`, de 5 em 5. Valor fora delas falha o build.
const MAX_CARACTERES = 120;
const MAX_LINHAS = 80;

const saida = await Astro.slots.render("default");
const caracteres = [...comando].length;
const linhas = saida.split("\n").length;

if (caracteres > MAX_CARACTERES || linhas > MAX_LINHAS) {
  throw new Error(
    `Terminal.astro: comando com ${caracteres} caracteres (máximo ${MAX_CARACTERES}) e saída com ` +
      `${linhas} linhas (máximo ${MAX_LINHAS}). Amplie as faixas em estilos/terminal.css.`,
  );
}

const faixa = (valor: number) => Math.ceil(valor / 5) * 5;
const classes = `n-${faixa(caracteres)} l-${faixa(linhas)}`;
---

<figure class="terminal" aria-label={rotulo}>
  <figcaption class="cabeca">{titulo}</figcaption>
  <pre
    class={classes}
    tabindex="0"
  ><span class="t-dim">$</span> <span class="digita">{comando}</span><span class="saida" set:html={saida} /></pre>
</figure>

<style>
  /* Fundo escuro nos dois esquemas: o terminal é o único ponto de ênfase (RF-08). */
  .terminal {
    overflow: hidden;
    border: 1px solid var(--term-border);
    border-radius: 12px;
    background: var(--term-bg);
    color: var(--term-text);
  }

  .cabeca {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 16px;
    border-bottom: 1px solid var(--term-border);
    color: var(--term-muted);
    font-family: var(--font-code);
    font-size: var(--fs-rotulo);
  }

  /* `overflow-x: auto` faz a linha larga rolar dentro do bloco; `tabindex=0` deixa o teclado rolar. */
  pre {
    margin: 0;
    padding: 16px;
    overflow-x: auto;
    font-family: var(--font-code);
    font-size: var(--fs-rotulo);
    line-height: 1.35;
    white-space: pre;
  }

  /* Cada linha de saída ocupa o espaço final desde o primeiro quadro (a animação só recorta).
   * `width: max-content` faz a caixa cobrir a linha mais larga, e não só a largura visível do `<pre>`: o
   * `clip-path` da animação recorta na borda da caixa e, no fim dela, `inset(0)` continua valendo, então
   * com a caixa estreita o texto que rola para o lado ficaria cortado no celular. `min-width: 100%` evita
   * que a caixa fique mais estreita que o bloco. */
  .saida {
    display: block;
    width: max-content;
    min-width: 100%;
  }

  /* Pista de rolagem no celular: as duas camadas `local` (cobertura, na cor do fundo) andam com o
   * conteúdo e escondem a sombra na ponta em que a rolagem já chegou; as duas `scroll` (sombra) ficam
   * coladas na borda. Resultado: sombra só do lado em que há linha escondida. */
  @media (max-width: 719px) {
    pre {
      background:
        linear-gradient(to right, var(--term-bg), var(--term-bg)) left center / 20px 100% no-repeat
          local,
        linear-gradient(to left, var(--term-bg), var(--term-bg)) right center / 20px 100% no-repeat
          local,
        radial-gradient(farthest-side at 0 50%, rgb(255 255 255 / 0.2), transparent) left center /
          12px 100% no-repeat scroll,
        radial-gradient(farthest-side at 100% 50%, rgb(255 255 255 / 0.2), transparent) right
          center / 12px 100% no-repeat scroll;
    }
  }

  @media (min-width: 720px) {
    pre {
      padding: 22px 24px;
      font-size: var(--fs-codigo);
    }
  }
</style>
