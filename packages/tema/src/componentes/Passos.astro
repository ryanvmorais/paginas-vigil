---
/**
 * @file Passos numerados: uma sequência de três colunas no desktop e empilhada no celular.
 *
 * A numeração é verdadeira (é uma ordem de execução), por isso a lista é `<ol>`. Cada passo tem
 * título, texto, e um trecho de código opcional. O texto aceita `<code>` e entra por `set:html`
 * (texto nosso). O rótulo ("Passo", "Step") vem do site (RF-09).
 *
 * No trecho de código a linha só quebra nos espaços: cada palavra do comando fica inteira
 * (`palavras.ts`), senão `--html` aparece partido em `--` e `html`. Uma palavra mais larga que o
 * bloco ainda quebra por dentro, em vez de gerar rolagem lateral.
 */
import { palavrasEmHtml } from "../palavras";

export interface Props {
  passos: { titulo: string; texto: string; codigo?: string }[];
  /** Palavra antes do número, por exemplo "Passo". Aparece em maiúsculas. */
  rotuloPasso: string;
}

const { passos, rotuloPasso } = Astro.props;
---

<ol class="passos">
  {passos.map((passo, i) => (
    <li class="passo">
      <span class="numero">
        {rotuloPasso} {i + 1}
      </span>
      <h3>{passo.titulo}</h3>
      <p set:html={passo.texto} />
      {passo.codigo !== undefined && <div class="codigo" set:html={palavrasEmHtml(passo.codigo)} />}
    </li>
  ))}
</ol>

<style>
  .passos {
    display: grid;
    gap: 28px;
  }

  .passo {
    display: grid;
    gap: 8px;
    align-content: start;
    min-width: 0;
    padding-top: 12px;
    border-top: 2px solid var(--text);
  }

  .numero {
    color: var(--text-3);
    font-family: var(--font-code);
    font-size: var(--fs-rotulo);
    font-weight: 700;
    text-transform: uppercase;
  }

  h3 {
    font-size: var(--fs-abertura);
    font-weight: 700;
  }

  p {
    color: var(--text-2);
    font-size: var(--fs-corpo);
    text-wrap: pretty;
  }

  p :global(code) {
    padding: 1px 5px;
    border-radius: 6px;
    background: var(--code);
    font-family: var(--font-code);
    font-size: 0.875em;
    white-space: nowrap;
  }

  .codigo {
    padding: 10px 12px;
    border-radius: 8px;
    background: var(--code);
    font-family: var(--font-code);
    font-size: var(--fs-codigo);
    overflow-wrap: anywhere;
    white-space: pre-wrap;
  }

  /* Palavra inteira: bloco em linha não quebra no hífen; se não couber, `anywhere` a parte. */
  .codigo :global(.palavra) {
    display: inline-block;
    max-width: 100%;
    overflow-wrap: anywhere;
    vertical-align: top;
  }

  @media (min-width: 720px) {
    .passos {
      grid-template-columns: repeat(3, 1fr);
      gap: 32px;
    }
  }
</style>
