---
/**
 * @file Rodapé: nome e licença, link do outro produto, item extra opcional, política e o seletor de idioma.
 *
 * O item extra (por exemplo o link do DMARC Fácil, no MailVigil) entra no
 * `slot`, ao lado do link do outro produto. A navegação do rodapé tem rótulo próprio, vindo de
 * `textos.ts`; o seletor de idioma é o mesmo do cabeçalho (RF-09).
 *
 * O link "Política de Privacidade" aparece sempre; o botão "Gerenciar Cookies" só existe com medição
 * (identificador válido) e nasce `hidden`: o `scripts/consentimento.ts` o revela, como o botão de
 * copiar do `Comando`. Os dois ficam fora da navegação "Mais projetos", que lista só projetos
 * (RF-04, RF-05).
 */
import type { Idioma } from "../idiomas";
import { validarIdMedicao } from "../medicao";
import { POLITICA } from "../politica";
import { textos } from "../textos";
import SeletorIdioma from "./SeletorIdioma.astro";

export interface Props {
  nome: string;
  licenca: string;
  outroProduto: { nome: string; href: string };
  idioma: Idioma;
  /** Caminho da página na versão atual; vai ao seletor de idioma. */
  caminho: string;
}

const { nome, licenca, outroProduto, idioma, caminho } = Astro.props;
const t = textos[idioma].rodape;
const politica = POLITICA[idioma];
const comMedicao = validarIdMedicao(import.meta.env.PUBLIC_GA_MEASUREMENT_ID) !== undefined;
---

<footer class="rodape">
  <div class="envoltorio conteudo">
    <span>
      {nome} · {licenca}
    </span>
    <div class="links">
      <nav aria-label={t.maisProjetos}>
        <a href={outroProduto.href}>{outroProduto.nome}</a>
        <slot />
      </nav>
      <div class="legal">
        <a href={politica.href}>
          {t.politica}
          {!politica.traduzida && ` ${textos[idioma].consentimento.foraDoIdioma}`}
        </a>
        {comMedicao && (
          <button type="button" data-gerenciar-cookies hidden>
            {t.gerenciar}
          </button>
        )}
      </div>
      <SeletorIdioma idioma={idioma} caminho={caminho} marco={false} />
    </div>
  </div>
</footer>

<style>
  .rodape {
    padding-block: 24px;
    border-top: 1px solid var(--border);
    color: var(--text-3);
    font-size: var(--fs-codigo);
  }

  .conteudo {
    display: grid;
    gap: 8px;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 18px;
  }

  nav,
  .legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 18px;
  }

  /* Alvo de toque de 44 px (RNF-02). */
  nav :global(a),
  .legal a,
  .legal button {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .legal button {
    padding: 0;
    border: 0;
    background: none;
    color: var(--link);
    font: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
    cursor: pointer;
  }

  /* `display` acima vence o `hidden` do navegador; sem esta regra o botão apareceria sem JavaScript. */
  .legal button[hidden] {
    display: none;
  }

  @media (min-width: 720px) {
    .conteudo {
      grid-template-columns: 1fr auto;
      align-items: center;
    }
  }
</style>
