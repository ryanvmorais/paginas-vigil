---
/**
 * @file Topo da página: título, texto de apoio, ações, comando de instalação e a linha fina.
 *
 * Os botões entram no slot `acoes` e o `Comando` no slot `comando`; o resto é texto. O título ocupa a
 * largura da coluna (até 50 px) e, no celular, quebra equilibrado (`text-wrap: balance`); termine-o com
 * espaços não separáveis para a quebra cair na frase. O bloco do comando leva `id="instalar"`, o alvo
 * do item "Instalar" da navegação.
 */
export interface Props {
  titulo: string;
  /** Parágrafo de apoio, com até 72 caracteres por linha. */
  apoio: string;
  /** Linha fina: requisitos e licença. */
  fina: string;
}

const { titulo, apoio, fina } = Astro.props;
---

<section class="envoltorio topo">
  <h1>{titulo}</h1>
  <p class="apoio">{apoio}</p>
  <div class="acoes">
    <slot name="acoes" />
  </div>
  <div id="instalar">
    <slot name="comando" />
  </div>
  <p class="fina">{fina}</p>
</section>

<style>
  /* `minmax(0, 1fr)`: sem isso a coluna cresce até a largura do comando (`nowrap`) e empurra os
   * botões para fora da tela; com ele o comando rola por dentro do próprio bloco (RNF-02). */
  .topo {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
    padding-block: 40px 28px;
  }

  /* 7,2 vw até o teto de 50 px: o título cresce com a janela (ADR-5, no lugar do `cqw` do mockup). */
  h1 {
    font-family: var(--font-title);
    font-weight: 800;
    font-size: clamp(30px, 7.2vw, 50px);
    line-height: 1.1;
    text-wrap: pretty;
  }

  .apoio {
    max-width: 72ch;
    color: var(--text-2);
    font-size: 17px;
    line-height: 1.55;
  }

  .acoes {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .fina {
    color: var(--text-3);
    font-size: 13px;
  }

  @media (max-width: 560px) {
    h1 {
      text-wrap: balance;
    }
  }

  @media (min-width: 720px) {
    .topo {
      gap: 24px;
      padding-block: 72px 44px;
    }

    .apoio {
      font-size: 19px;
    }
  }
</style>
