---
/**
 * @file Seletor de idioma PT · EN: dois links reais para a mesma página nos dois idiomas.
 *
 * O idioma atual não é um link: vira um `span` com `aria-current="page"`. Cada link leva `lang` e
 * `hreflang` do idioma de destino, para o leitor de tela pronunciar o nome certo. O texto visível é a
 * sigla (`PT`, `EN`); o nome completo vem de `textos.ts` e fica só para o leitor de tela, o que mantém
 * o nome acessível contendo o texto visível (RF-05).
 *
 * A página tem o seletor no cabeçalho e outro no rodapé. Só o primeiro é um marco `nav`: dois marcos
 * com o mesmo rótulo confundem quem navega por marcos, então o do rodapé (`marco={false}`) é um
 * `div role="group"` com o mesmo rótulo.
 */
import { caminhoNoIdioma } from "../caminhos";
import { IDIOMAS, type Idioma } from "../idiomas";
import { textos } from "../textos";

export interface Props {
  /** Idioma da página atual. */
  idioma: Idioma;
  /** Caminho da página na versão atual; o link do outro idioma é calculado a partir dele. */
  caminho: string;
  /** `true` (padrão) renderiza um marco `nav`; `false`, um grupo sem marco, para a segunda ocorrência. */
  marco?: boolean;
}

const { idioma, caminho, marco = true } = Astro.props;
const Raiz = marco ? "nav" : "div";
const t = textos[idioma];
const LANG = { pt: "pt-BR", en: "en" } as const;
---

<Raiz class="seletor" role={marco ? undefined : "group"} aria-label={t.seletorIdioma.rotulo}>
  {IDIOMAS.map((alvo) => {
    const conteudo = (
      <>
        <span aria-hidden="true">{alvo.toUpperCase()}</span>
        <span class="so-leitor">{t.seletorIdioma[alvo]}</span>
      </>
    );
    return alvo === idioma ? (
      <span class="idioma" lang={LANG[alvo]} aria-current="page">
        {conteudo}
      </span>
    ) : (
      <a
        class="idioma"
        href={caminhoNoIdioma(caminho, alvo)}
        lang={LANG[alvo]}
        hreflang={LANG[alvo]}
      >
        {conteudo}
      </a>
    );
  })}
</Raiz>

<style>
  /* Alvo de toque de 44 px de altura e 40 de largura (RNF-02). Sem sublinhado: o idioma atual se
   * distingue pelo traço de acento e pelo texto mais forte, não só pela cor. */
  .seletor {
    display: flex;
    align-items: center;
  }

  .idioma {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    min-width: 40px;
    padding: 0 8px;
    border-radius: 8px;
    font-size: var(--fs-codigo);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-decoration: none;
    color: var(--text-3);
  }

  a.idioma:hover {
    color: var(--text);
  }

  .idioma[aria-current="page"] {
    color: var(--text);
    border-radius: 0;
    box-shadow: inset 0 -2px 0 var(--acc);
  }
</style>
