---
/**
 * @file Bloco "o que ele não faz": um quadro com borda, título e o texto no `slot`.
 *
 * Limite factual, sem promessa. Em toda largura empilha: título em cima e o texto na largura da caixa,
 * sem teto de medida (RF-08, ADR-3). O `h2` do bloco precisa de seletor mais específico que o `h2` das
 * seções (`.secao h2`), senão herda os 34 px.
 */
export interface Props {
  titulo: string;
}

const { titulo } = Astro.props;
---

<section class="secao">
  <div class="envoltorio">
    <div class="limites">
      <h2>{titulo}</h2>
      <slot />
    </div>
  </div>
</section>

<style>
  .limites {
    display: grid;
    gap: 10px;
    padding: 20px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--card);
  }

  .limites h2 {
    margin: 0;
    font-size: var(--fs-marca);
  }

  .limites :global(p) {
    color: var(--text-2);
    text-wrap: pretty;
  }

  @media (min-width: 720px) {
    .limites {
      padding: 28px 32px;
    }
  }
</style>
