{
  "ci": {
    "collect": {
      "staticDistDir": "./apps/mailvigil/dist",
      "url": ["/index.html", "/en/index.html"],
      "numberOfRuns": 3,
      "settings": {
        "formFactor": "mobile",
        "skipAudits": ["robots-txt"]
      }
    },
    "assert": {
      "aggregationMethod": "median-run",
      "assertions": {
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "color-contrast": [
          "error",
          {
            "minScore": 1
          }
        ],
        "unsized-images": [
          "error",
          {
            "minScore": 1
          }
        ],
        "target-size": [
          "error",
          {
            "minScore": 1
          }
        ],
        "errors-in-console": [
          "error",
          {
            "minScore": 1
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.1
          }
        ],
        "categories:performance": [
          "warn",
          {
            "minScore": 0.9
          }
        ],
        "total-byte-weight": [
          "warn",
          {
            "maxNumericValue": 512000
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/mailvigil-mobile"
    }
  }
}
